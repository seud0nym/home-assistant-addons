#!/bin/bash
# This script is intended to be called by .git/hooks/pre-commit. e.g.:
#
#   #!/bin/bash
#
#   source "$(cd "$(dirname "$0")/../../scripts"; pwd)/pre-commit"

set -euo pipefail

cd "$(cd "$(dirname "$0")"/..; pwd)"

# Paths to watch, relative to the app directory ("*" matches any depth)
MONITORED=(
  "config.yaml"
  "Dockerfile"
  "rootfs/*"
  "translations/*"
)

# Get staged files
mapfile -t STAGED < <(git diff --cached --name-only)

declare -A APPS=()
for f in "${STAGED[@]}"; do
  if [[ "$f" == tests/*/* ]]; then
    # tests/<app>/...
    app="${f#tests/}"
    app="${app%%/*}"
    rel="tests"
  else
    app="${f%%/*}"
    rel="${f#*/}"
  fi
  [[ -f "$app/config.yaml" ]] || continue
  [[ "$rel" == "tests" ]] && { APPS["$app"]=1; continue; }
  for m in "${MONITORED[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$rel" == $m ]]; then
      APPS["$app"]=1
      break
    fi
  done
done

if [[ ${#APPS[@]} -eq 0 ]]; then
  exit 0
fi

branch=$(git branch --show-current)

for app in "${!APPS[@]}"; do
  version=$(grep '^version:' "$app/config.yaml" | cut -d'"' -f2 || true)
  if [[ -z "$version" ]]; then
    continue
  fi

  # Validate branch/version consistency
  if [[ "$branch" == "main" ]]; then
    if [[ "$version" =~ [ab][0-9]+$ ]]; then
      echo "ERROR: Main branch requires a stable version (no [ab]N suffix), but found '$version'"
      exit 1
    fi
  fi

  grep -q "^## \[${version}\]" "$app/CHANGELOG.md" ||  { echo "No change log found for version $version in $app!"; exit 1; }

  if [[ -d "tests/$app" ]]; then
    tests/run_all.sh "$app" -q
  fi
done
